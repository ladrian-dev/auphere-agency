# Public site URL — used for metadata, sitemap, hreflang
NEXT_PUBLIC_SITE_URL=https://auphere.com

# Cal.com booking link — slug only (without https://cal.com/ prefix)
# Real event: https://cal.com/auphere-team/diagnostico-auphere-45-min-sin-coste
NEXT_PUBLIC_CAL_LINK=auphere-team/diagnostico-auphere-45-min-sin-coste

# Resend (form de contacto alternativo, opcional)
RESEND_API_KEY=

# Plausible domain (analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=auphere.com
