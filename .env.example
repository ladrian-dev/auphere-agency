# Public site URL — used for metadata, sitemap, hreflang
NEXT_PUBLIC_SITE_URL=https://auphere.com

# Cal.com booking link — slug only (without https://cal.com/ prefix)
# Format: <user-or-team>/<event-slug>
# Verify by opening https://cal.com/<value> in incognito.
NEXT_PUBLIC_CAL_LINK=auphere-team/diagnostico-auphere-30-min-sin-coste

# Resend (form de contacto alternativo, opcional)
RESEND_API_KEY=

# Plausible domain (analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=auphere.com

# ─── Entorno de despliegue ───────────────────────────────────────────────────
# Vercel rellena VERCEL_ENV solo (production | preview). Esta variable solo hace
# falta para forzar el entorno a mano (self-host, o un preview que deba
# comportarse como producción). Valores: production | staging | development.
# Fuera de 'production': robots.txt cierra todo, se manda X-Robots-Tag noindex,
# aparece el sello de staging y el formulario de partners no envía correo.
NEXT_PUBLIC_DEPLOY_ENV=

# Puerta de staging (landing-staging.auphere.com). Formato usuario:clave.
# Si está vacía NO hay puerta. Definir SOLO en el entorno Preview de Vercel —
# nunca en Production, o auphere.com pediría contraseña.
STAGING_BASIC_AUTH=

# Destinatario y remitente de las solicitudes del programa de partners
PARTNER_APPLICATIONS_TO=
PARTNER_APPLICATIONS_FROM=
